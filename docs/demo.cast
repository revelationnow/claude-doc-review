9m  - It mirrors what people already know from GitHub reviews.                                                \u001b[49m\u001b[27;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[39m                                                                                                             \u001b[49m\u001b[28;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[38;2;153;153;153m·\u001b[39m  \u001b[1m3.3 Escalation path per block\u001b(B\u001b[m\u001b[48;2;38;38;38m                                                                             \u001b[49m\u001b[29;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[39m                                                                                                             \u001b[49m\u001b[30;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[38;2;153;153;153m·\u001b[39m  Every ask-mode exchange has three exits, drawn as plain Buttons under it:                                 \u001b[49m\u001b[31;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[39m                                                                                                             \u001b[49m\u001b[32;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[38;2;153;153;153m·\u001b[39m  - \u001b[1mKeep as comment\u001b(B\u001b[m\u001b[48;2;38;38;38m: converts the Q and A into a pinned review comment.                                     \u001b[49m\u001b[33;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[38;2;153;153;153m·\u001b[39m  - \u001b[1mSend to conversation\u001b(B\u001b[m\u001b[48;2;38;38;38m: \u001b[38;2;177;185;249m$.prompt.submit\u001b[39m right now with the block as                                       \u001b[49m\u001b[34;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[39m     hidden context, for when the user wants the model to act immediately.                 