[0.202, "o", "\u001b[3;55H\u001b[48;2;38;38;38m4. Enter on a block opens an inline composer under it (an \u001b[38;2;177;185;249mInput\u001b[39m with                             \u001b[4;58H\u001b[38;2;177;185;249mautoFocus\u001b[39m).\u001b[CThe\u001b[Cuser\u001b[Ctypes\u001b[Ca\u001b[Ccomment\u001b[Cand\u001b[Cpresses\u001b[CEnter.\u001b[CThe\u001b[Ccomment\u001b[Cis\u001b[5;52H \u001b[2C  \u001b[Cpinned under the block, dim, prefixed with a marker. No model call\u001b[Cyet.\u001b[6;52H\u001b[38;2;153;153;153m·\u001b[2C\u001b[39m5.\u001b[C\u001b[38;2;177;185;249ma\u001b[39m on a block opens the same composer in \u001b[1mask\u001b(B\u001b[m\u001b[48;2;38;38;38m mode. Enter sends the     \u001b[7;58Hquestion through \u001b[38;2;177;185;249m$.model.fork\u001b[39m with the quoted block as the first line of\u001b[8;52H \u001b[2C  \u001b[Cthe prompt. The answer streams in under the block. Nothing enters\u001b[Cthe\u001b[Cmain\u001b[9;58Htranscript. The exchange is kept on the block and can be turned into a  \u001b[10;58Hcomment with one press.                                                   \u001b[11;52H\u001b[38;2;153;153;153m·\u001b[2C\u001b[39m6.\u001b[C\u001b[38;2;177;185;249ms\u001b[39m submits the review. The mod builds one prompt from all pinned comments,\u001b[12;58Heach anchored by heading\u001b[Cpath\u001b[Cand\u001b[Cquoted\u001b[Ctext,\u001b[Cand\u001b[Ccalls\u001b[13;52H \u001b[2C  \u001b[C\u001b[38;2;177;185;249m$.prompt.submit\u001b[39m. The model revises the document in the main conversation \u001b[14;58Has usual. The pane stays open and refreshes on the next \u001b[38;2;177;185;249mWrite\u001b[39m/\u001b[38;2;177;185;249mEdit\u001b[39m.\u001b[15;52H\u001b[38;2;153;153;153m·\u001b[2C\u001b[39m7.\u001b[C\u001b[38;2;177;185;249mo\u001b[39m approves: submits the plugin's expected approval phrase (for superpowers,\u001b[16;58H\"Looks good, proceed\") so the plugin's own flow continues.         \u001b[17;52H \u001b[2C  \u001b[C                                                                           \u001b[18;52H\u001b[38;2;153;153;153m·\u001b[2C\u001b[39m\u001b[1m3.2 Why this beats a per-line chat window\u001b(B\u001b[m\u001b[48;2;38;38;38m                    \u001b[20;55H- One revision pass instead of many partial\u001b[Cedits.\u001b[CCheaper\u001b[Cand\u001b[Cthe\u001b[Cdocument\u001b[21;57Hstays\u001b[Ccoherent.\u001b[22;55H-\u001b[CClarifying questions do not pollute the main context. \u001b[38;2;177;185;249m$.model.fork\u001b[39m reuses\u001b[23;57Hthe cached prefix,\u001b[Cso\u001b[Ceach\u001b[Cquestion\u001b[Ccosts\u001b[Croughly\u001b[Cone\u001b[Cshort\u001b[Creply.\u001b[24;55H-\u001b[CThe user keeps control of when the model acts. Nothing is sent until \u001b[38;2;177;185;249ms\u001b[39m or\u001b[25;57H\u001b[38;2;177;185;249mo\u001b[39m.                                                                \u001b[26;55H-\u001b[CIt mirrors what people already know from GitHub reviews.                 \u001b[27;57H  \u001b[28;55H\u001b[1m3.3 Escalation path per block\u001b(B\u001b[m\u001b[48;2;38;38;38m                             \u001b[30;55HEvery ask-mode exchange has three\u001b[Cexits,\u001b[Cdrawn\u001b[Cas\u001b[Cplain\u001b[CButtons\u001b[Cunder\u001b[Cit:\u001b[32;55H- \u001b[1mKeep as comment\u001b(B\u001b[m\u001b[48;2;38;38;38m: converts the Q and A into a pinned review comment.    \u001b[33;52H\u001b[38;2;153;153;153m·\u001b[2C\u001b[39m-\u001b[C\u001b[1mSend to conversation\u001b(B\u001b[m\u001b[48;2;38;38;38m:\u001b[C\u001b[38;2;177;185;249m$.prompt.submit\u001b[C\u001b[39mright\u001b[Cnow\u001b[Cwith\u001b[Cthe\u001b[Cblock\u001b[Cas\u001b[34;52H \u001b[2C \u001b[Chidden context, for when the user wants the model to act immediately.\u001b[35;52H \u001b[2C\u001b[38;2;245;217;10m✎ Say which block the hidden context is, so the model can quote it back.\u001b[33C\u001b[38;2;153;153;153m✕\u001b[36;52H\u001b[39m▶\u001b[2C-\u001b[C\u001b[1mDismiss\u001b(B\u001b[m\u001b[48;2;38;38;38m.                                                             \u001b[37;55H\u001b[38;2;5;162;194m? Does Dismiss also drop the question from the saved store?\u001b[39m             \u001b[33C \u001b[38;52H \u001b[2C\u001b[38;2;153;153;153masking…\u001b[39m   \u001b[39;55H\u001b[7mcomment\u001b(B\u001b[m\u001b[38;2;153;153;153m\u001b[48;2;38;38;38m · ask · explain\u001b[39m                 \u001b[C      \u001b[42;3H\u001b(B\u001b[m"]
[1.846, "o", "\u001b[?25l\u001b[1;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[39m                                                                                                           \u001b[38;2;153;153;153m✕\u001b[39m \u001b[49m\u001b[38;2;215;119;87m\u001b[2;1H ▐\u001b[48;2;0;0;0m▛███▛█\u001b[39m\u001b[49m\u001b[3X\u001b[1m\u001b[3CClaude Code\u001b(B\u001b[m\u001b[1X\u001b[38;2;153;153;153m\u001b[Cv2.1.289\u001b[39m\u001b[19X\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[19C│\u001b[39m                                                                                                             \u001b[49m\u001b[38;2;215;119;87m\u001b[3;1H▝▜\u001b[48;2;0;0;0m█████\u001b[49m█▀\u001b[39m\u001b[2X\u001b[38;2;153;153;153m\u001b[2CFable 5.1 · Claude Pro\u001b[39m\u001b[17X\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[17C│\u001b[38;2;153;153;153m·\u001b[39m  4. Enter on a block opens an inline composer under it (an \u001b[38;2;177;185;249mInput\u001b[39m with                                      \u001b[49m\u001b[38;2;215;119;87m\u001b[4;1H ▝▝   ▝▝ \u001b[39m\u001b[2X\u001b[38;2;153;153;153m\u001b[2C/tmp/claude-doc-review\u001b[39m\u001b[17X\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[17C│\u001b[39m      \u001b[38;2;177;185;249mautoFocus\u001b[39m). The user types a comment and presses Enter. The comment is                                 \u001b[49m\u001b[5;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[39m      pinned under the block, dim, prefixed with a marker. No model call yet.                                \u001b[49m\u001b[6;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[38;2;153;153;153m·\u001b[39m  5. \u001b[38;2;177;185;249ma\u001b[39m on a block opens the same composer in \u001b[1mask\u001b(B\u001b[m\u001b[48;2;38;38;38m mode. Enter sends the                                      \u001b[38;2;153;153;153m\u001b[48;2;55;55;55m\u001b[7;1H❯\u001b[39m \u001b[38;2;255;255;255m/doc-review DESIGN.md\u001b[39m \u001b[49m                          \u001b[38;2;177;185;249m\u001b[48;2;38;38;38m│\u001b[39m      question through \u001b[38;2;177;185;249m$.model.fork\u001b[39m with the quoted block as the first line of                               \u001b[49m\u001b[38;2;153;153;153m\u001b[8;1H  ⎿  \u001b[39mdoc-review:\u001b[1X\u001b[CReviewing\u001b[1X\u001b[CDESIGN.md.\u001b[1X\u001b[CIn\u001b[1X\u001b[Cthe\u001b[1X\u001b[Cpane:\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m│\u001b[39m      the prompt. The answer streams in under the block. Nothing enters the main                             \u001b[49m\u001b[9;5H\u001b[1K\u001b[Cj/k\u001b[1X\u001b[Cmove,\u001b[1X\u001b[Cf\u001b[1X\u001b[Cfind,\u001b[1X\u001b[Cc\u001b[1X\u001b[Ccomment,\u001b[1X\u001b[Ca\u001b[1X\u001b[Cask,\u001b[1X\u001b[Ch\u001b[8X\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[8C│\u001b[39m      transcript. The exchange is kept on the block and can be turned into a                                 \u001b[49m\u001b[10;5H\u001b[1K\u001b[Cexplain,\u001b[1X\u001b[Cs\u001b[1X\u001b[Csubmit\u001b[1X\u001b[Creview,\u001b[1X\u001b[Co\u001b[1X\u001b[Capprove,\u001b[1X\u001b[Cd\u001b[1X\u001b[Cdiff,\u001b[1X\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[39m      comment with one press.                                                                                \u001b[49m\u001b[11;5H\u001b[1K\u001b[Cx\u001b[1X\u001b[Cclose.\u001b[1X\u001b[CTab\u001b[1X\u001b[Calso\u001b[1X\u001b[Cwalks\u001b[1X\u001b[Cthe\u001b[1X\u001b[Cblocks.\u001b[10X\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[10C│\u001b[38;2;153;153;153m·\u001b[39m  6. \u001b[38;2;177;185;249ms\u001b[39m submits the review. The mod builds one prompt from all pinned comments,                              \u001b[49m\u001b[12;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[39m      each anchored by heading path and quoted text, and calls                                               \u001b[49m\u001b[13;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[39m      \u001b[38;2;177;185;249m$.prompt.submit\u001b[39m. The model revises the document in the main conversation                               \u001b[49m\u001b[14;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[39m      as usual. The pane stays open and refreshes on the next \u001b[38;2;177;185;249mWrite\u001b[39m/\u001b[38;2;177;185;249mEdit\u001b[39m.                                    \u001b[49m\u001b[15;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[38;2;153;153;153m·\u001b[39m  7. \u001b[38;2;177;185;249mo\u001b[39m approves: submits the plugin's expected approval phrase (for superpowers,                            \u001b[49m\u001b[16;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[39m      \"Looks good, proceed\") so the plugin's own flow continues.                                             \u001b[49m\u001b[17;50H\u001b[1K\u001b[38;2;177;185;249m\u001b[48;2;38;38;38m\u001b[C│\u001b[39m                                                                                                             \u001b[49m\u001b["]
